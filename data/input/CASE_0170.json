{
 "case_id": "CASE_0170",
 "desired": {
  "apiVersion": "batch/v1",
  "kind": "CronJob",
  "metadata": {
   "annotations": {},
   "labels": {
    "app.kubernetes.io/component": "pg_dumpall",
    "app.kubernetes.io/instance": "postgresql-prod",
    "app.kubernetes.io/managed-by": "Helm",
    "app.kubernetes.io/name": "postgresql",
    "app.kubernetes.io/version": "18.6.0",
    "environment": "prod",
    "helm.sh/chart": "postgresql-18.12.14"
   },
   "name": "postgresql-prod-pgdumpall",
   "namespace": "postgresql-prod"
  },
  "spec": {
   "concurrencyPolicy": "Allow",
   "failedJobsHistoryLimit": 1,
   "jobTemplate": {
    "spec": {
     "template": {
      "metadata": {
       "annotations": {},
       "labels": {
        "app.kubernetes.io/component": "pg_dumpall",
        "app.kubernetes.io/instance": "postgresql-prod",
        "app.kubernetes.io/managed-by": "Helm",
        "app.kubernetes.io/name": "postgresql",
        "app.kubernetes.io/version": "18.6.0",
        "helm.sh/chart": "postgresql-18.12.14"
       }
      },
      "spec": {
       "containers": [
        {
         "command": [
          "/bin/bash",
          "-c",
          "PGPASSWORD=\"${PGPASSWORD:-$(< \"$PGPASSWORD_FILE\")}\" pg_dumpall --clean --if-exists --load-via-partition-root --quote-all-identifiers --no-password --file=\"${PGDUMP_DIR}/pg_dumpall-$(date '+%Y-%m-%d-%H-%M').pgdump\""
         ],
         "env": [
          {
           "name": "PGUSER",
           "value": "postgres"
          },
          {
           "name": "PGPASSWORD_FILE",
           "value": "/opt/bitnami/postgresql/secrets/postgres-password"
          },
          {
           "name": "PGHOST",
           "value": "postgresql-prod"
          },
          {
           "name": "PGPORT",
           "value": "5432"
          },
          {
           "name": "PGDUMP_DIR",
           "value": "/backup/pgdump"
          },
          {
           "name": "OPENSSL_FIPS",
           "value": "yes"
          },
          {
           "name": "OPENSSL_FIPS_PROVIDER_PATH",
           "value": "/etc/ssl/provider_fips.cnf"
          }
         ],
         "image": "registry-1.docker.io/bitnami/postgresql:18.6.0",
         "imagePullPolicy": "IfNotPresent",
         "name": "postgresql-prod-pgdumpall",
         "resources": {
          "limits": {
           "cpu": "150m",
           "ephemeral-storage": "2Gi",
           "memory": "192Mi"
          },
          "requests": {
           "cpu": "100m",
           "ephemeral-storage": "50Mi",
           "memory": "128Mi"
          }
         },
         "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
           "drop": [
            "ALL"
           ]
          },
          "privileged": false,
          "readOnlyRootFilesystem": true,
          "runAsGroup": 1001,
          "runAsNonRoot": true,
          "runAsUser": 1001,
          "seLinuxOptions": {},
          "seccompProfile": {
           "type": "RuntimeDefault"
          }
         },
         "volumeMounts": [
          {
           "mountPath": "/backup/pgdump",
           "name": "datadir",
           "subPath": null
          },
          {
           "mountPath": "/tmp",
           "name": "empty-dir",
           "subPath": "tmp-dir"
          },
          {
           "mountPath": "/opt/bitnami/postgresql/secrets/",
           "name": "postgresql-password"
          }
         ]
        }
       ],
       "restartPolicy": "OnFailure",
       "securityContext": {
        "fsGroup": 1001,
        "fsGroupChangePolicy": "Always",
        "seccompProfile": {
         "type": "RuntimeDefault"
        },
        "supplementalGroups": [],
        "sysctls": []
       },
       "volumes": [
        {
         "name": "datadir",
         "persistentVolumeClaim": {
          "claimName": "postgresql-prod-pgdumpall"
         }
        },
        {
         "emptyDir": {},
         "name": "empty-dir"
        },
        {
         "name": "postgresql-password",
         "secret": {
          "secretName": "postgresql-prod"
         }
        }
       ]
      }
     }
    }
   },
   "schedule": "@daily",
   "successfulJobsHistoryLimit": 3
  }
 },
 "diff": [
  {
   "new": true,
   "old": null,
   "op": "add",
   "path": "/spec/jobTemplate/spec/template/spec/automountServiceAccountToken"
  }
 ],
 "environment": "prod",
 "namespace": "postgresql-prod",
 "resource_kind": "CronJob",
 "resource_name": "postgresql-prod-pgdumpall"
}